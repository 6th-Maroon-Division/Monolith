<tabs:DeltaTab xmlns="https://spacestation14.io"
                  xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                  xmlns:tabs="clr-namespace:Content.Client._DV.Options.UI.Tabs"
                  xmlns:xNamespace="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:s="clr-namespace:Content.Client.Stylesheets">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Vertical" Margin="8 8 8 8" VerticalExpand="True">
            <Label Text="{Loc 'ui-options-general-forknotice'}"
                   FontColorOverride="{xNamespace:Static s:StyleNano.ConcerningOrangeFore}"
                   StyleClasses="LabelKeyText"/>
            <Label Text="{Loc 'ui-options-general-accessibility'}"
                   FontColorOverride="{xNamespace:Static s:StyleNano.NanoGold}"
                   StyleClasses="LabelKeyText"/>
            <CheckBox Name="DisableFiltersCheckBox" Text="{Loc 'ui-options-no-filters'}" />
             <Label Text="{Loc 'ui-options-general-programmable-computer'}"
                 FontColorOverride="{xNamespace:Static s:StyleNano.NanoGold}"
                 StyleClasses="LabelKeyText"/>
             <OptionButton Name="KeyboardLayoutOption" HorizontalExpand="True" />
             <BoxContainer Orientation="Horizontal" Margin="0 8 0 0" SeparationOverride="4">
                 <Button Name="SaveDefaultWindowSizeButton" 
                         Text="{Loc 'ui-options-programmable-computer-save-default-size'}"
                         ToolTip="{Loc 'ui-options-programmable-computer-save-default-size-tooltip'}" />
                 <Button Name="ResetWindowSizesButton" 
                         Text="{Loc 'ui-options-programmable-computer-reset-sizes'}"
                         ToolTip="{Loc 'ui-options-programmable-computer-reset-sizes-tooltip'}" />
             </BoxContainer>
        </BoxContainer>
        <controls:StripeBack HasBottomEdge="False" HasMargins="False">
            <Button Name="ApplyButton"
                    Text="{Loc 'ui-options-apply'}"
                    TextAlign="Center"
                    HorizontalAlignment="Right" />
        </controls:StripeBack>
    </BoxContainer>
</tabs:DeltaTab>
