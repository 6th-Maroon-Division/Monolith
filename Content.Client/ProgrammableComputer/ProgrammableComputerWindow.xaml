<controls:FancyWindow xmlns="https://spacestation14.io"
                     xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     xmlns:pc="clr-namespace:Content.Client.ProgrammableComputer"
                     Title="{Loc 'programmable-computer-ui-title'}"
                     MinSize="700 480"
                     SetSize="700 480">
    <BoxContainer Orientation="Vertical"
                  SeparationOverride="6"
                  Margin="10 10 10 10">
        <BoxContainer Orientation="Horizontal"
                      SeparationOverride="6">
            <Button Name="StartButton" Text="Start" />
            <Button Name="ShutdownButton" Text="Shutdown" />
            <Button Name="RebootButton" Text="Reboot" />
            <Label Name="PowerStateLabel"
                   Text="Power: OFF"
                   VerticalAlignment="Center" />
        </BoxContainer>

        <PanelContainer HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RectClipContent="True">
            <pc:ProgrammableComputerTerminalBox Name="TerminalSurface" />
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>