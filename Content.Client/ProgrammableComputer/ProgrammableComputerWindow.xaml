<controls:FancyWindow xmlns="https://spacestation14.io"
                     xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     xmlns:pc="clr-namespace:Content.Client.ProgrammableComputer"
                     Title="{Loc 'programmable-computer-ui-title'}"
                     MinSize="320 260">
    <BoxContainer Orientation="Vertical"
                  SeparationOverride="4"
                  Margin="8 8 8 8"
                  VerticalExpand="True"
                  HorizontalExpand="True">
        <BoxContainer Orientation="Horizontal"
                      SeparationOverride="4">
            <Button Name="StartButton" Text="Start" />
            <Button Name="ShutdownButton" Text="Shutdown" />
            <Button Name="RebootButton" Text="Reboot" />
            <Button Name="DevicesButton" Text="{Loc 'programmable-computer-devices-button'}" />
            <Button Name="FilesButton" Text="{Loc 'programmable-computer-files-button'}" />
            <Label Name="PowerStateLabel"
                   Text="Power: OFF"
                   VerticalAlignment="Center" />
        </BoxContainer>

        <PanelContainer HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalExpand="True"
                        VerticalExpand="True"
                        RectClipContent="True">
            <pc:ProgrammableComputerTerminalBox Name="TerminalSurface" />
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>