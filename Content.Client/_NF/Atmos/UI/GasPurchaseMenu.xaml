<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      SetSize="300 230"
                      MinSize="300 230"
                      Title="{Loc 'gas-purchase-console-menu-title'}">
    <BoxContainer Orientation="Vertical" Margin="5" HorizontalExpand="True">
        <GridContainer Columns="2"
                       Margin="5 0 5 0"
                       HSeparationOverride="5"
                       HorizontalAlignment="Stretch"
                       HorizontalExpand="True">
            <Label Text="{Loc 'gas-purchase-menu-gas-label'}"
                   StyleClasses="LabelKeyText" />
            <OptionButton Name="GasSelector"
                          HorizontalExpand="True" />

            <Label Text="{Loc 'gas-purchase-menu-moles-label'}"
                   StyleClasses="LabelKeyText" />
            <LineEdit Name="AmountInput"
                      HorizontalExpand="True" />

            <Label Text="{Loc 'gas-purchase-menu-price-label'}"
                   StyleClasses="LabelKeyText" />
            <Label Name="PriceLabel"
                   Text="{Loc 'gas-purchase-menu-no-value'}"
                   HorizontalAlignment="Right" />

            <Label Text="{Loc 'gas-purchase-menu-linked-points-label'}"
                   StyleClasses="LabelKeyText" />
            <Label Name="LinkedPointsLabel"
                   Text="0"
                   HorizontalAlignment="Right" />
        </GridContainer>

        <Button Name="RefreshButton"
                Text="{Loc 'gas-purchase-refresh-button'}"
                Margin="5 5 5 0" />
        <Button Name="PurchaseButton"
                Text="{Loc 'gas-purchase-buy-button'}"
                Margin="5 0 5 0" />
        <TextureButton VerticalExpand="True" />
    </BoxContainer>
</controls:FancyWindow>